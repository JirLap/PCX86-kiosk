{
  "config": {
    "step": {
      "user": {
        "title": "PCX86-kiosk",
        "description": "The integration is added automatically after a Debian panel publishes its retained MQTT discovery message."
      },
      "confirm": {
        "title": "Panel discovered: {name}",
        "description": "Choose a name for this panel and optionally assign it to an area. Home Assistant may also show its standard device/area summary after confirmation.",
        "data": {
          "name": "Device name",
          "area_id": "Area"
        }
      }
    },
    "abort": {
      "no_devices_found": "No panel was discovered. Check that the Debian agent is running and connected to the same MQTT broker, then restart Home Assistant or retry discovery.",
      "invalid_discovery": "The MQTT announcement is invalid or does not match the PCX86-kiosk topic contract.",
      "already_configured": "This panel is already configured.",
      "already_in_progress": "Setup for this panel is already in progress."
    }
  },
  "options": {
